{
  "name": "nova-boutique",
  "version": "0.1.0",
  "private": true,
  "description": "SaaS de creation de boutique en ligne par l'IA, pour l'Afrique de l'Ouest",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "verifier": "tsc --noEmit",
    "seed": "node scripts/seed.mjs",
    "reset": "node scripts/reset.mjs",
    "essais": "tsc -p tsconfig.essais.json && node --conditions=react-server --test essais/*.test.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "better-sqlite3": "^12.2.0",
    "next": "^15.5.24",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
