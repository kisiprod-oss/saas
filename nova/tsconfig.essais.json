{
  "//": "Compile la couche metier en CommonJS pour que `node --test` puisse l'exercer telle quelle, sans dupliquer la logique dans les essais.",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": ".essais",
    "jsx": "react-jsx",
    "declaration": false,
    "incremental": false,
    "types": ["node"]
  },
  "include": ["src/lib/**/*.ts"],
  "exclude": ["node_modules", "src/lib/actions-*.ts", "src/lib/boutique-publique.ts"]
}
