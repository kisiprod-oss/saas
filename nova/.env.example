# ============================================================================
#  NOVA Boutique — configuration
# ============================================================================
#  Copiez ce fichier en `.env.local` et remplissez ce dont vous avez besoin.
#  AUCUN secret réel ne doit se retrouver dans ce fichier-ci : il est suivi par
#  git. `.env.local` est ignoré (voir .gitignore).
#
#  Rien n'est obligatoire pour faire tourner l'application en local :
#  `npm run dev` fonctionne avec un fichier vide. Chaque variable absente
#  désactive proprement une fonction, et l'interface le dit à l'écran plutôt
#  que de tomber en panne.
# ============================================================================


# ----------------------------------------------------------------------------
#  1. LE MINIMUM POUR UNE MISE EN PRODUCTION
# ----------------------------------------------------------------------------

# L'adresse publique du service, sans barre oblique finale. Sert aux liens de
# réinitialisation de mot de passe, au plan du site et à l'adresse de
# notification affichée aux commerçants.
NOVA_URL_PUBLIQUE=https://nova.shop

# Le domaine racine. Les boutiques sont servies sur <slug>.NOVA_DOMAINE_RACINE
# (voir src/middleware.ts). En local, laissez la valeur par défaut et utilisez
# /b/<slug>.
NOVA_DOMAINE_RACINE=nova.shop

# Clé de chiffrement des secrets des commerçants (clés de leur prestataire de
# paiement). 32 caractères minimum, tirés au hasard.
#
#   openssl rand -base64 48
#
# SANS ELLE : le mode « réel » du paiement en ligne est REFUSÉ côté serveur, et
# l'interface l'annonce. Aucune clé n'est jamais stockée en clair.
#
# ATTENTION : si vous la changez, les clés déjà enregistrées deviennent
# illisibles et les commerçants doivent les ressaisir. Sauvegardez-la.
NOVA_CLE_SECRETE=

# Emplacement des données : base SQLite et photos. Un seul dossier à
# sauvegarder. Mettez-le sur un volume persistant.
NOVA_DOSSIER_DONNEES=./donnees
# NOVA_FICHIER_BASE=./donnees/nova.db


# ----------------------------------------------------------------------------
#  2. L'ASSISTANT INTELLIGENT
# ----------------------------------------------------------------------------

# Clé d'API Anthropic. À créer sur https://console.anthropic.com/
#
# SANS ELLE : l'application fonctionne, et l'assistant bascule sur un moteur
# LOCAL qui compose les pages et les descriptions à partir des seules
# informations saisies par le commerçant. Il n'invente rien — mais il ne
# comprend pas une demande en français libre (« ajoute une section
# présentation ») et le dit clairement.
ANTHROPIC_API_KEY=

# Modèle utilisé. Par défaut : claude-sonnet-5.
# NOVA_MODELE_IA=claude-sonnet-5


# ----------------------------------------------------------------------------
#  3. ADMINISTRATION
# ----------------------------------------------------------------------------

# Le premier compte administrateur est créé au premier chargement de
# /administration/connexion, à partir de ces variables.
#
# SANS ELLES : l'espace d'administration est inaccessible, et la page de
# connexion explique quoi poser. C'est le bon comportement pour une
# installation qu'on vient de déployer.
#
# Le mot de passe doit faire 12 caractères minimum. Retirez-le de
# l'environnement après la première connexion si vous préférez : le compte
# reste en base.
NOVA_ADMIN_EMAIL=
NOVA_ADMIN_MOTDEPASSE=
NOVA_ADMIN_NOM=Administration


# ----------------------------------------------------------------------------
#  4. ENVOI D'E-MAILS
# ----------------------------------------------------------------------------

# Adresse d'un service d'envoi qui accepte un POST JSON
# { destinataire, sujet, texte }, et une clé facultative en en-tête
# Authorization: Bearer.
#
# SANS ELLE : la réinitialisation de mot de passe fonctionne, mais le lien
# part dans le JOURNAL DU SERVEUR au lieu d'un e-mail, et le message à l'écran
# le dit. Le lien n'est JAMAIS affiché au visiteur — sinon n'importe qui
# réinitialiserait n'importe quel compte en devinant une adresse.
#
# CE QU'IL RESTE À FAIRE : choisir un fournisseur (Brevo, Resend, Mailgun,
# un SMTP maison…) et adapter `envoyerLien()` dans src/lib/actions-compte.ts à
# son format d'appel. C'est une quinzaine de lignes.
NOVA_SMTP_URL=
NOVA_SMTP_CLE=


# ----------------------------------------------------------------------------
#  5. PAIEMENT EN LIGNE — CE QUE VOUS N'AVEZ PAS À METTRE ICI
# ----------------------------------------------------------------------------
#  Les clés des prestataires de paiement ne sont PAS des variables
#  d'environnement : elles appartiennent à chaque commerçant, qui les saisit
#  dans Tableau de bord → Paiements. Elles sont chiffrées avec
#  NOVA_CLE_SECRETE avant d'être stockées, et ne redescendent jamais dans un
#  navigateur.
#
#  Les paiements des clients vont sur le compte marchand du commerçant, pas
#  sur le nôtre. Ce circuit est séparé de la facturation des abonnements.
#
#  État réel des intégrations : src/lib/paiements.ts, et la page
#  /administration/integrations. À ce jour, aucune n'a fait de transaction
#  réelle de bout en bout ; le mode test, lui, fonctionne et se vérifie depuis
#  la page Paiements du commerçant.
# ----------------------------------------------------------------------------
