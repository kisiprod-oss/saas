# Copiez ce fichier en « .env.local » et renseignez vos valeurs.
# Aucune de ces variables n'est obligatoire pour démarrer.

# Adresse publique du site, utilisée dans les liens des e-mails
ADRESSE_SITE=https://sengestion.sn

# Serveur d'envoi d'e-mails.
# Sans ces variables, les e-mails sont écrits dans data/emails/ au lieu d'être envoyés.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_EXPEDITEUR="Sen Gestion <contact@sengestion.sn>"

# Emplacement de la base de données (facultatif)
# DATABASE_FILE=/var/data/sen-gestion.db
