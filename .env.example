# Copiez ce fichier en « .env.local » à la racine du projet, puis renseignez
# vos valeurs. Ce fichier n'est jamais envoyé sur GitHub.
#
# Après modification, vérifiez la configuration avec :
#   npm run tester-email

# ---------------------------------------------------------------------------
# Adresse publique du site — sert à construire les liens dans les e-mails.
#
# Recopiez ici l'adresse réelle du site : le domaine temporaire de votre
# hébergeur au début (https://xxx.hostingersite.com), puis votre vrai domaine.
# En développement : http://localhost:3000
#
# Si vous l'omettez, l'application déduit l'adresse de la navigation en cours.
# Les liens fonctionnent, mais renseigner cette variable reste plus sûr.
# ---------------------------------------------------------------------------
ADRESSE_SITE=https://votre-adresse.hostingersite.com

# ---------------------------------------------------------------------------
# Serveur d'envoi d'e-mails.
# Sans ces variables, l'application fonctionne, mais les messages sont écrits
# dans data/emails/ au lieu d'être envoyés : personne ne peut alors récupérer
# un mot de passe oublié.
#
# --- Brevo (recommandé, 300 e-mails par jour gratuits) ---
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=votre adresse de connexion Brevo
#   SMTP_PASS=la « clé SMTP » créée dans SMTP & API — PAS le mot de passe du compte
#
# --- Gmail ou Google Workspace ---
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=vous@votre-domaine.sn
#   SMTP_PASS=un « mot de passe d'application » (validation en deux étapes requise)
#
# --- Hébergeur classique (cPanel, OVH, Hostinger…) ---
#   SMTP_HOST=mail.votre-domaine.sn
#   SMTP_PORT=587
#   SMTP_USER=contact@votre-domaine.sn   (adresse complète)
#   SMTP_PASS=le mot de passe de la boîte
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Adresse affichée comme expéditeur. Le domaine doit être vérifié chez votre
# fournisseur, sinon les messages partiront en indésirables.
EMAIL_EXPEDITEUR="Sen Gestion <contact@sengestion.sn>"

# ---------------------------------------------------------------------------
# Emplacement des données (base + photos + e-mails de secours).
#
# ⚠️ IMPORTANT sur un hébergement qui remplace le dossier de l'application à
# chaque déploiement (Hostinger, Render, Railway…) : placez ce dossier
# AILLEURS, sinon chaque mise à jour effacerait vos données.
# ---------------------------------------------------------------------------
# DOSSIER_DONNEES=/home/u123456789/donnees-sen-gestion

# Nombre de sauvegardes conservées par npm run sauvegarde (14 par défaut)
# SAUVEGARDES_A_CONSERVER=14

# ---------------------------------------------------------------------------
# Connexion des agences avec leur compte Google (facultatif).
#
# Sans ces deux variables, le bouton « Se connecter avec Google » n'apparaît
# pas et tout le reste fonctionne normalement.
#
# Pour les obtenir : console.cloud.google.com → APIs et services →
# « Identifiants » → Créer des identifiants → ID client OAuth → Application Web.
# Dans « URI de redirection autorisés », collez EXACTEMENT :
#   https://votre-adresse.hostingersite.com/connexion/google/retour
#   http://localhost:3000/connexion/google/retour        (pour vos essais)
#
# ⚠️ GOOGLE_CLIENT_SECRET est un mot de passe : ne le partagez avec personne
# et ne le collez jamais dans une conversation.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
